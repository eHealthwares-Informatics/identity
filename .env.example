# ─────────────────────────────────────────────────────────────
# identity — environment template
#
# Copy to .env and fill in. Values below are the code defaults where the
# code has one; blank values are required in production (the service fails
# closed without them). Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────
PORT=8092

# error | warn | log | debug | verbose (default: log)
LOG_LEVEL=log

# ── Master database (PostgreSQL) ────────────────────────────
# DB_TYPE=sqlite is supported for local tests only.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=identity

# Auto-create/alter tables from the entities. Keep `true` only where schema
# sync is acceptable (dev/staging); use migrations for production.
DB_SYNCHRONIZE=true

# DESTRUCTIVE: drops the entire schema on boot. Only for a deliberate reset.
DB_DROP_SCHEMA=false

# Log every SQL statement (very noisy).
TYPEORM_LOGGING=false

# ── Auth / JWT ──────────────────────────────────────────────
# identity is the ISSUER: rxsoft, lims and emr must be configured with the
# same JWT_ACCESS_SECRET. No code fallback — the API fails closed (500) when
# unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Maximum per-user session timeout in minutes, enforced at login
# (default: 1440 = 24 h).
ACCESS_TOKEN_TTL_MAX_MINUTES=1440

# Shared secret for service-to-service calls (header: x-api-key). Callers
# presenting it are treated as `system` / super_admin. Refused when unset.
INTERNAL_API_KEY=

# ── Onboarding (public self-serve) ──────────────────────────
# Gate for POST /auth/onboard-organization (provisions identity + rxsoft
# backend + emr reference data in one call).
ONBOARD_ORGANISATIONS_ENABLED=true

# ── Provisioning targets ────────────────────────────────────
# Mandatory named TypeORM connections used by the provisioner; the service
# fails fast at boot when either is unreachable. Same PostgreSQL instance as
# identity in the container stack.
BACKEND_DB_HOST=localhost
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=
BACKEND_DB_NAME=rxsoft

EMR_DB_HOST=localhost
EMR_DB_PORT=5432
EMR_DB_USER=postgres
EMR_DB_PASSWORD=
EMR_DB_NAME=emr

# Optional: pre-generated retail price mirror for provisioned price lists
# (`[{ price_list_code, item_code, unit_price }]`). A missing file or `[]`
# falls back to the deterministic demo price band.
# PROVISION_PRICE_MIRROR=resources/price_list_items.json

# ── Website domain resolution ───────────────────────────────
# Reserved: the domain→organisation middleware currently always runs, so this
# flag is not read by the code. Kept for forward compatibility; leave `true`.
WEBSITE_DOMAIN_RESOLUTION_ENABLED=true

# Removed: seeding on startup no longer exists in this service (seed data is
# applied by the `seed` service against these databases). Setting this has no
# effect; kept here only so old .env files are recognisable.
SEED_ON_START=false

# ── Storefront shopper tenant ───────────────────────────────
# Organisation carried in the JWT for website/mobile shoppers (register, OTP,
# OAuth) so the rxsoft backend prices carts from the same tenant's lists.
# Falls back to the built-in DEFAULT_ORG_ID constant when unset.
SHOPPER_DEFAULT_ORGANIZATION_ID=

# Conversation service used to deliver OTP messages. No trailing slash.
CONVERSATION_SERVICE_URL=http://localhost:8090/api
# Conversation channel codes used to route OTPs.
SMS_CHANNEL_CODE=SMS_PROXY
WHATSAPP_CHANNEL_CODE=WHATSAPP_EHEALTHWARES

# ── Social sign-in (website / mobile) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web OAuth client ID(s) accepted as the Google ID-token audience
# (comma-separated to allow more than one Google Cloud project during
# migration). Falls back to the built-in project list when unset.
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── OAuth channel tenancy (optional overrides) ──────────────
# Each OAuth channel (website | console | shopper | emr) can bind sign-ins to
# its own organisation and role set. Unset channels fall back to
# SHOPPER_DEFAULT_ORGANIZATION_ID and the `website_user` role.
# OAUTH_<CHANNEL>_ORGANIZATION_ID / OAUTH_<CHANNEL>_ROLES (comma-separated)
OAUTH_WEBSITE_ORGANIZATION_ID=
OAUTH_WEBSITE_ROLES=
OAUTH_CONSOLE_ORGANIZATION_ID=
OAUTH_CONSOLE_ROLES=
# OAUTH_SHOPPER_ORGANIZATION_ID=
# OAUTH_SHOPPER_ROLES=
# OAUTH_EMR_ORGANIZATION_ID=
# OAUTH_EMR_ROLES=
