# JWT signing secret — identity is the ISSUER: every other service (rxsoft,
# lims, emr) must be configured with the same value. No code fallback: the
# API fails closed (500) when unset.
JWT_ACCESS_SECRET=

# Gate for the public self-serve onboarding endpoint (POST /auth/onboard-organization).
ONBOARD_ORGANISATIONS_ENABLED=true

# Application log level: error | warn | log | debug | verbose (default: log)
LOG_LEVEL=log

# Provisioning service (seed) connection for onboarding.
SEED_PROVISION_URL=
SEED_PROVISION_API_KEY=
