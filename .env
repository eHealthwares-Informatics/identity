PORT=8092
JWT_ACCESS_SECRET=admin-access-secret
JWT_REFRESH_SECRET=admin-refresh-secret
# Maximum per-user session timeout (minutes) enforced at login (default: 1440).
ACCESS_TOKEN_TTL_MAX_MINUTES=10080
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=identity
DB_SYNCHRONIZE=true
DB_DROP_SCHEMA=false
TYPEORM_LOGGING=false
SEED_ON_START=false
INTERNAL_API_KEY=rxsoft-internal-key

# ── self-serve onboarding («Onboard your Organisation» on the login page) ──
# identity exposes POST /auth/onboard-organization and forwards the request to
# the seed service provisioning module (service-to-service with x-api-key).
ONBOARD_ORGANISATIONS_ENABLED=true
SEED_PROVISION_URL=http://localhost:8093
SEED_PROVISION_API_KEY=admin-access-secret
# ── Mobile shopper self-onboarding (phone + OTP) ────────────────────────────
SHOPPER_DEFAULT_ORGANIZATION_ID=df3b4afd-9955-4617-9a82-264cc73dd8b2
CONVERSATION_SERVICE_URL=http://localhost:8090/api
SMS_CHANNEL_CODE=SMS_PROXY
WHATSAPP_CHANNEL_CODE=WHATSAPP_EHEALTHWARES
